#!/usr/bin/env python3
"""Stand-in for pcb2gcode: reads ./millproject like the real one and writes
one .ngc file per job. FAKE_PCB2GCODE_FAIL=1 makes it fail."""
import os
import sys

if os.environ.get("FAKE_PCB2GCODE_FAIL"):
    print("ERROR: simulated failure")
    sys.exit(3)

config = "millproject"
if "--config" in sys.argv:
    config = sys.argv[sys.argv.index("--config") + 1]
options = {}
with open(config) as fh:
    for line in fh:
        line = line.strip()
        if line and not line.startswith("#"):
            key, value = line.split("=", 1)
            if key in options:
                print("ERROR: option '{}' given twice".format(key))
                sys.exit(4)
            options[key] = value

SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="100" height="80" viewBox="0 0 100 80"><rect width="100" height="80" fill="#eee"/></svg>\n'
for key in ("front", "back", "outline"):
    if key in options:
        for name in ("processed_{}.svg", "traced_{}.svg"):
            with open(name.format(key), "w") as fh:
                fh.write(SVG)
if "drill" in options:
    with open("original_drill.svg", "w") as fh:
        fh.write(SVG)
if os.environ.get("FAKE_CONTENTIONS") and "back" in options:
    with open("contentions_back.svg", "w") as fh:
        fh.write(SVG)

for key in ("front", "back", "drill", "outline"):
    if key in options:
        if not os.path.isfile(options[key]):
            print("ERROR: missing input " + options[key])
            sys.exit(5)
        with open("{}_{}.ngc".format(options["basename"], key), "w") as fh:
            fh.write("G94\nG21\nG90\n"
                     "G00 Z10 (Retract to tool change height)\nT1\nM5      (Spindle stop.)\n"
                     "(MSG, Change tool bit to mill diameter 0.154mm)\n"
                     "M0      (Temporary machine stop.)\nM3 ( Spindle on clockwise. )\n"
                     "G01 X1 Y1\n"
                     "G00 Z10 (Retract to tool change height)\nT2\nM5      (Spindle stop.)\n"
                     "M0      (Temporary machine stop.)\nM3 ( Spindle on clockwise. )\n"
                     "G01 X2 Y2\nM5\nM2\n")
        print("Processing {} ... done".format(key))
